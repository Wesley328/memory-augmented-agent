OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.2

# Optional embedding overrides. Leave blank to fall back to the local hash embedder.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# Local runtime defaults. Docker Compose overrides the SQLite path to /app/data/... inside the container.
MEMORY_STORE_BACKEND=sqlite
MEMORY_SQLITE_PATH=data/memory_agent.db
MEMORY_TOP_K=3
MEMORY_MAX_SIZE=200
MEMORY_TYPE_AWARE=true
MEMORY_QUERY_AWARE_ROUTING=false
MEMORY_ENABLE_MMR=false
MEMORY_MMR_LAMBDA=0.7
MEMORY_MMR_CANDIDATE_POOL=4
